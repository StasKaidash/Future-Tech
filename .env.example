# ---------------------------------------------------------------------------
# Future Tech — environment variables
# ---------------------------------------------------------------------------
# Used by the TL;DR Netlify Function (netlify/functions/tldr.js).
# The browser never sees this key — it lives on the server only.
#
#  • Production: set ANTHROPIC_API_KEY in the Netlify dashboard:
#       Site settings → Environment variables → Add variable
#  • Local dev: copy this file to `.env`, paste your real key,
#       then run `netlify dev` (NOT `npm start`).
#
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key-here
