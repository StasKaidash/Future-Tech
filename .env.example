# ---------------------------------------------------------------------------
# Future Tech — environment variables
# ---------------------------------------------------------------------------
# Used by the TL;DR serverless function (api/tldr.js).
# The browser never sees this key — it lives on the server only.
#
#  • Production: set ANTHROPIC_API_KEY in the Vercel dashboard:
#       Project → Settings → Environment Variables → Add
#  • Local dev: copy this file to `.env.local`, paste your real key,
#       then run `vercel dev` (NOT `npm start`).
#
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key-here
